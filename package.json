{
  "name": "vyona",
  "private": true,
  "description": "VYONA Weligama: public site, admin and booking engine",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @vyona/db run generate",
    "db:migrate": "pnpm --filter @vyona/db run migrate",
    "db:deploy": "pnpm --filter @vyona/db run migrate:deploy",
    "db:seed": "pnpm --filter @vyona/db run seed",
    "db:studio": "pnpm --filter @vyona/db run studio",
    "media:import": "pnpm --filter @vyona/db run media:import"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3"
  }
}
