# Copy to .env for local overrides. docker-compose.yml already sets the
# database, Redis, SMTP and media paths for development.

# PayHere sandbox (https://sandbox.payhere.lk). Left empty in development, card
# payments go to the built-in test gateway at /book/pay/mock instead; in
# production, empty switches card payments off. PAYHERE_SANDBOX=0 goes live.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=1

# Beds24 API v2 (Booking.com). Empty token = a local stand-in in development, and sync off in
# production. The refresh token comes from Beds24 → Settings → Marketplace → API.
BEDS24_REFRESH_TOKEN=
# Any long random string. In Beds24, set the booking webhook to
#   https://vyonaweligama.com/api/webhooks/beds24?key=<this value>
# Without it the webhook only answers in test mode; the 10-minute poll still catches everything.
BEDS24_WEBHOOK_SECRET=

# Sender of booking emails (SMTP_URL is set in docker-compose.yml: Mailpit)
MAIL_FROM=VYONA Weligama <stay@vyonaweligama.com>

# Admin login seeded on first start; also receives new-booking and refund emails
ADMIN_EMAIL=
ADMIN_PASSWORD=
