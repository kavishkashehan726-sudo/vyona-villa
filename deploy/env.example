# The server's .env, in the app folder next to ecosystem.config.cjs. Never commit the filled copy.
# scripts/deploy-app.sh refuses to run until it exists on the server. chmod 600.
# Node reads it with --env-file: one KEY=value per line; quote a value that has # or spaces.

# Postgres and Redis on the server itself. The password is the one given to the vyona role
# (deploy/README.md); make it hex (openssl rand -hex 24) so it needs no escaping in the URL.
DATABASE_URL=postgresql://vyona:CHANGE_ME@127.0.0.1:5432/vyona
# On a Redis shared with other apps, give VYONA a database of its own (/5 here): BullMQ queue
# names like `sync` would otherwise collide. `redis-cli info keyspace` shows the ones in use.
REDIS_URL=redis://127.0.0.1:6379/5

# Local ports CloudPanel proxies to; pick free ones (`ss -ltn`). The VPS uses 3020/3021,
# because other sites hold 3000-3012.
WEB_PORT=3020
ADMIN_PORT=3021

# Search engines: 1 once the client confirms real prices.
SITE_INDEXABLE=0

# First admin login, created once by the seed; also receives booking and refund emails.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email: smtp://user:pass@host:587 from the SMTP provider.
SMTP_URL=
MAIL_FROM=VYONA Weligama <stay@vyonaweligama.com>

# PayHere. Empty = card payments off. PAYHERE_SANDBOX=0 goes live.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=1

# Beds24 (Booking.com). Empty token = sync off.
BEDS24_REFRESH_TOKEN=
BEDS24_WEBHOOK_SECRET=
